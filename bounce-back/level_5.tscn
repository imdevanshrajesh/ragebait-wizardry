[sub_resource type="GDScript" id="GDScript_ootpb"]
script/source = "extends Node2D

@export var required_bounces: int = 1
@export_file(\"*.tscn\") var next_level_path: String = \"\"

@onready var enemies_folder: Node2D = $Enemies
@onready var ui: CanvasLayer = $UI
@onready var label: Label = $UI/Label
@onready var player: Node2D = $Player
var sound_played: bool = false
var transitioning: bool = false

func _ready() -> void:
	ui.visible = true
	label.position = Vector2(60, 60)
	label.add_theme_font_size_override(\"font_size\", 44)
	label.add_theme_color_override(\"font_color\", Color.BLACK)
	if required_bounces > 1:
		player.required_bounces = required_bounces

func get_target_next_level() -> String:
	if next_level_path != \"\":
		return next_level_path
	if scene_file_path.ends_with(\"level_1.tscn\") and ResourceLoader.exists(\"res://level_2.tscn\"):
		return \"res://level_2.tscn\"
	if scene_file_path.ends_with(\"level_2.tscn\") and ResourceLoader.exists(\"res://level_3.tscn\"):
		return \"res://level_3.tscn\"
	return \"\"

func _process(_delta: float) -> void:
	if Input.is_key_pressed(KEY_R):
		get_tree().reload_current_scene()
		return
	if enemies_folder.get_child_count() == 0:
		var target := get_target_next_level()
		if target != \"\":
			label.text = \"YOU WIN! Loading Next Level...\"
			if not transitioning:
				transitioning = true
				await get_tree().create_timer(1.0).timeout
				get_tree().change_scene_to_file(target)
		else:
			label.text = \"YOU BEAT THE GAME! (Press R to Replay)\"
	elif not is_instance_valid(player) or player.is_dead:
		if sound_played == false:
			sound_played = true
			var sfx = AudioStreamPlayer.new()
			sfx.stream = load(\"res://Assets/death.mp3\")
			add_child(sfx)
			sfx.play()
		label.text = \"YOU DIED! (Press R to Retry)\"
	elif player.ammo <= 0 and get_tree().get_nodes_in_group(\"bullets\").is_empty():
		label.text = \"OUT OF AMMO! (Press R to Retry)\"
	else:
		var current_bounces := 0
		if is_instance_valid(player.last_bullet):
			current_bounces = player.last_bullet.bounces_done
		label.text = \"Ammo: \" + str(player.ammo) + \" | Min Bounces: \" + str(player.required_bounces) + \" | Bounces: \" + str(current_bounces)
"

