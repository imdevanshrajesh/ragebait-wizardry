[sub_resource type="GDScript" id="GDScript_ootpb"]
script/source = "extends Node2D

@export var next_level: PackedScene

@onready var enemies_folder: Node2D = $Enemies
@onready var ui: CanvasLayer = $UI
@onready var label: Label = $UI/Label
@onready var player: Node2D = $Player

func _ready() -> void:
	ui.visible = true
	label.position = Vector2(60, 60)
	label.add_theme_font_size_override(\"font_size\", 48)

func _process(_delta: float) -> void:
	if Input.is_key_pressed(KEY_R):
		get_tree().reload_current_scene()
		return
	if enemies_folder.get_child_count() == 0:
		if next_level != null:
			label.text = \"YOU WIN! Press SPACE for Next Level\"
			if Input.is_key_pressed(KEY_SPACE):
				get_tree().change_scene_to_packed(next_level)
		else:
			label.text = \"YOU WIN! (Press R to Replay)\"
	elif not is_instance_valid(player):
		label.text = \"YOU DIED! (Press R to Retry)\"
	elif player.ammo <= 0 and get_tree().get_nodes_in_group(\"bullets\").is_empty():
		label.text = \"OUT OF AMMO! (Press R to Retry)\"
	else:
		label.text = \"Ammo: \" + str(player.ammo) + \" | Min Bounces: \" + str(player.required_bounces)
"

